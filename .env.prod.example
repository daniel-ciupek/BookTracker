# Wygeneruj APP_KEY poleceniem: cd backend && php artisan key:generate --show
APP_KEY=base64:CHANGE_ME

# Publiczny adres serwera (bez trailing slash)
APP_URL=http://yourdomain.com

# PostgreSQL
DB_DATABASE=booktracker
DB_USERNAME=booktracker
DB_PASSWORD=change-me-strong-password

# Port nasłuchiwania nginx (domyślnie 80)
PORT=80
